# ═══════════════════════════════════════════════════════════════════════════════
# ems-backend-python/.env.example
# Copy to .env and fill in your values before running uvicorn locally.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: provide a full connection URL (takes priority if set)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/EMSNew

# Option B: individual fields (used as fallback when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=EMSNew
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=8640000000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── Chatbot / Groq LLM ────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
