# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — Copy to .env and fill in your own values
# Used by: docker-compose.yml  +  ems-backend-python (via env_file)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# When running with Docker Compose, DB_HOST is overridden to "db" automatically.
# When running locally (no Docker), set DB_HOST to "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=EMSNew
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Change this to a long random string in production!
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=8640000000   # 100 days

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password (not your account password).
# Guide: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For production on Render, set this to your frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Cookie ────────────────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true and COOKIE_SAME_SITE=None for production HTTPS deployments.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── Chatbot / Groq LLM ────────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Frontend (Vite build-time variables — used by Docker Compose build arg) ───
VITE_API_BASE_URL=/api

# ── Mobile (Expo) ─────────────────────────────────────────────────────────────
# Set to your machine's LAN IP so the Expo app can reach the backend.
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api
