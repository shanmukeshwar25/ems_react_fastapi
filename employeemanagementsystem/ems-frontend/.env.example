# ═══════════════════════════════════════════════════════════════════════════════
# ems-frontend/.env.example
# Copy to .env and fill in your values before running `npm run dev`.
# All variables must start with VITE_ to be exposed to the browser.
# ═══════════════════════════════════════════════════════════════════════════════

# ── API URLs ──────────────────────────────────────────────────────────────────
# When running locally with `npm run dev`, Vite proxies /api → http://localhost:8000
# so you can leave this as /api and it will work automatically.
VITE_API_BASE_URL=/api

# The following are only needed if you want to point directly at a remote backend
# (e.g., the deployed Render backend) instead of using the local proxy.
# VITE_API_BASE_URL=https://ems-backend-zl35.onrender.com/api
# VITE_CHATBOT_API_URL=https://ems-backend-zl35.onrender.com/api/chatbot
# VITE_PARSER_URL=https://ems-backend-zl35.onrender.com

# ── Session ───────────────────────────────────────────────────────────────────
# How long (ms) before an idle session is automatically logged out. Default: 15 min.
VITE_SESSION_TIMEOUT_MS=900000

# ── Dev proxy (vite.config.js reads this — NOT a VITE_ var) ──────────────────
# Change to the URL of your backend if it's not running on localhost:8000.
BACKEND_URL=http://localhost:8000
