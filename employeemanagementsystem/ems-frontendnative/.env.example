# ═══════════════════════════════════════════════════════════════════════════════
# ems-frontendnative/.env.example  (TekSphere — Expo / React Native)
# Copy to .env and fill in your values before running `npx expo start`.
# Variables prefixed with EXPO_PUBLIC_ are embedded into the app bundle.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────────────────────────
# IMPORTANT: Use your machine's LAN IP address, NOT "localhost".
# "localhost" inside Expo Go / an Android emulator refers to the device itself.
#
# How to find your LAN IP:
#   Windows:  ipconfig  →  look for "IPv4 Address" (e.g. 192.168.1.42)
#   macOS/Linux: ifconfig | grep "inet "
#
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api

# ── Metro bundler hostname ────────────────────────────────────────────────────
# Must match your LAN IP so physical devices can connect to the Metro server.
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x
